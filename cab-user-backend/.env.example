NODE_ENV=development
PORT=5000
API_PREFIX=/api
APP_BASE_URL=http://localhost:5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_DEV_MODE=true
OTP_DEV_FIXED_CODE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cab_user_app
CORS_ORIGIN=*
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure a real SMS provider before setting OTP_DEV_MODE=false.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
